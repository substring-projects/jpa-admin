<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.substringtechnologies</groupId>
        <artifactId>jpa-admin-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>jpa-admin-spring-boot-starter</artifactId>
    <packaging>jar</packaging>
    <name>Spring Boot JPA Admin Starter</name>
    <description>Starter for automatically generating Admin UI for JPA entities in Spring Boot</description>

    <dependencies>
        <dependency>
            <groupId>com.substringtechnologies</groupId>
            <artifactId>jpa-admin-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.substringtechnologies</groupId>
            <artifactId>jpa-admin-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.substringtechnologies</groupId>
            <artifactId>jpa-admin-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>


    <!-- Non-Java modules still publish meaningful source and documentation artifacts. -->
    <profiles>
        <profile>
            <id>release</id>
            <build><plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <configuration><skipSource>true</skipSource></configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration><skip>true</skip></configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>attach-non-java-sources</id><phase>package</phase><goals><goal>jar</goal></goals>
                            <configuration>
                                <classifier>sources</classifier>
                                <classesDirectory>${project.basedir}</classesDirectory>
                                <includes><include>pom.xml</include><include>src/release-docs/**</include></includes>
                            </configuration>
                        </execution>
                        <execution>
                            <id>attach-non-java-documentation</id><phase>package</phase><goals><goal>jar</goal></goals>
                            <configuration>
                                <classifier>javadoc</classifier>
                                <classesDirectory>${project.basedir}/src/release-docs</classesDirectory>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins></build>
        </profile>
    </profiles>
</project>
